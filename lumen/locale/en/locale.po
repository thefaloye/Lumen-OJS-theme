msgid "plugins.themes.lumen.name"
msgstr "Lumen Theme"

msgid "plugins.themes.lumen.description"
msgstr ""
"An editorial, card-based journal theme with a hero banner, current-issue "
"showcase, announcements, indexing logos and a rich footer. Built on the "
"Default theme, so all inner pages keep working."

# ---- Theme options ---------------------------------------------------------

msgid "plugins.themes.lumen.option.primaryColor.label"
msgstr "Primary colour"

msgid "plugins.themes.lumen.option.primaryColor.description"
msgstr "Used for the top bar, hero banner, footer, headings and links."

msgid "plugins.themes.lumen.option.accentColor.label"
msgstr "Accent colour"

msgid "plugins.themes.lumen.option.accentColor.description"
msgstr "Used for buttons, highlights and hover states."

msgid "plugins.themes.lumen.option.useGoogleFonts.label"
msgstr "Typography"

msgid "plugins.themes.lumen.option.useGoogleFonts.description"
msgstr "Inter for text and Source Serif 4 for headings, loaded from Google Fonts."

msgid "plugins.themes.lumen.option.useGoogleFonts.option"
msgstr "Load fonts from Google Fonts (untick to use the visitor's system fonts)"

msgid "plugins.themes.lumen.option.topbarTagline.label"
msgstr "Top bar tagline"

msgid "plugins.themes.lumen.option.topbarTagline.description"
msgstr "A short line shown at the left of the top bar."

msgid "plugins.themes.lumen.option.heroEyebrow.label"
msgstr "Hero: small heading"

msgid "plugins.themes.lumen.option.heroEyebrow.description"
msgstr "The small uppercase line above the journal name on the homepage."

msgid "plugins.themes.lumen.option.heroSubtitle.label"
msgstr "Hero: subtitle"

msgid "plugins.themes.lumen.option.heroSubtitle.description"
msgstr "The larger line under the journal name."

msgid "plugins.themes.lumen.option.heroText.label"
msgstr "Hero: description"

msgid "plugins.themes.lumen.option.heroText.description"
msgstr "A sentence or two under the subtitle. The homepage image set under Website > Appearance > Setup is shown beside it."

msgid "plugins.themes.lumen.option.highlights.label"
msgstr "Highlights strip"

msgid "plugins.themes.lumen.option.highlights.description"
msgstr "Up to four lines in the form: Title | Short description. Leave empty for the defaults."

msgid "plugins.themes.lumen.option.subjectScope.label"
msgstr "Subject scope"

msgid "plugins.themes.lumen.option.subjectScope.description"
msgstr "One subject per line. Shown beside the journal description on the homepage. Leave empty to hide."

msgid "plugins.themes.lumen.option.indexing.label"
msgstr "Indexing and abstracting"

msgid "plugins.themes.lumen.option.indexing.description"
msgstr "One service per line in the form: Name | Link | Logo image URL (the link and logo are optional). Leave empty to hide the section."

msgid "plugins.themes.lumen.option.newsletterAction.label"
msgstr "Newsletter form address"

msgid "plugins.themes.lumen.option.newsletterAction.description"
msgstr "The form-post URL from your mailing-list service (Mailchimp, Brevo, MailerLite...). The email field is sent as EMAIL. Leave empty to hide the newsletter box."

msgid "plugins.themes.lumen.option.footerTagline.label"
msgstr "Footer tagline"

msgid "plugins.themes.lumen.option.footerTagline.description"
msgstr "A short line under the journal name in the footer."

msgid "plugins.themes.lumen.option.social.label"
msgstr "Footer connect links"

msgid "plugins.themes.lumen.option.social.description"
msgstr "One link per line in the form: Label | URL, for example: LinkedIn | https://linkedin.com/company/yourjournal. Use mailto: for an email link."

# ---- Default content -------------------------------------------------------

msgid "plugins.themes.lumen.default.topbarTagline"
msgstr "Scholarly publishing with clarity, integrity, and global reach."

msgid "plugins.themes.lumen.default.heroEyebrow"
msgstr "A Global Perspective"

msgid "plugins.themes.lumen.default.heroSubtitle"
msgstr "Advancing knowledge across cultures and disciplines"

msgid "plugins.themes.lumen.default.heroText"
msgstr "A peer-reviewed, open-access journal publishing high-quality research for a global scholarly community."

msgid "plugins.themes.lumen.default.highlight1.title"
msgstr "Peer Reviewed"

msgid "plugins.themes.lumen.default.highlight1.text"
msgstr "Rigorous and independent editorial process"

msgid "plugins.themes.lumen.default.highlight2.title"
msgstr "Open Access"

msgid "plugins.themes.lumen.default.highlight2.text"
msgstr "Knowledge for a more equitable world"

msgid "plugins.themes.lumen.default.highlight3.title"
msgstr "Regular Publication"

msgid "plugins.themes.lumen.default.highlight3.text"
msgstr "Consistent scholarly output"

msgid "plugins.themes.lumen.default.highlight4.title"
msgstr "Persistent Identifiers"

msgid "plugins.themes.lumen.default.highlight4.text"
msgstr "Persistent and citable research"

